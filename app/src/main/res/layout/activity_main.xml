<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:id="@+id/noticeText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:text="REQUIRED: Log in on this mobile app AND stay on the SAME network connection as your Roku (10.115.151.100) to pair."
        android:textSize="16sp" />

    <EditText
        android:id="@+id/rokuIpInput"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:hint="Roku IP (same Wi-Fi/LAN)"
        android:inputType="text"
        android:text="10.115.151.100" />

    <EditText
        android:id="@+id/tokenInput"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:hint="Account Token"
        android:inputType="textPassword" />

    <Button
        android:id="@+id/pairButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Verify Same Connection &amp; Pair Roku" />

    <TextView
        android:id="@+id/statusText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="Status: Waiting for login and same-network pairing."
        android:textSize="14sp" />
</LinearLayout>
